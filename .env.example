DATABASE_URL=file:geoking.db
# For Supabase, replace DATABASE_URL with the restricted server role pooler connection.
DATABASE_AUTH_TOKEN=
APP_URL=http://localhost:3000
# Public origin used in search metadata, structured data and sitemap.
SITE_URL=https://geoking.org
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
# Private Cloudflare R2 bucket used for seller KYC documents.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=geoking-kyc
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Administrator

# Supabase project settings. Never prefix server credentials with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional custom CA; the official Supabase CA is bundled by default.
DATABASE_SSL_CA=
